{ #category : 'entries' }
CairoPluginGuards class >> keyFromName: aString [
	"'Color>>red' -> #(#Color false #red); 'AthensCairoPath class>>primDestroyPath:' -> #(#AthensCairoPath true #primDestroyPath:)"

	| i className isMeta |
	i := aString indexOfSubCollection: '>>'.
	className := aString copyFrom: 1 to: i - 1.
	isMeta := className endsWith: ' class'.
	isMeta ifTrue: [ className := className allButLast: 6 ].
	^ { className asSymbol. isMeta. (aString allButFirst: i + 1) asSymbol }
]

{ #category : 'checking' }
CairoPluginGuards class >> methodAt: key [
	"The method a guard checks for key: the method found from the class (lookup), or, when it is a CairoPlugin patch, the recorded original; nil when missing"

	| cls m |
	cls := Smalltalk globals at: (key at: 1) ifAbsent: [ ^ nil ].
	cls isBehavior ifFalse: [ ^ nil ].
	(key at: 2) ifTrue: [ cls := cls class ].
	m := cls lookupSelector: (key at: 3).
	m ifNil: [ ^ nil ].
	(CairoPluginInstaller isPatch: m) ifTrue: [
		^ CairoPluginInstaller originalAt: {
				  m methodClass instanceSide name.
				  m methodClass isMeta.
				  (key at: 3) } ].
	^ m
]

{ #category : 'checking' }
CairoPluginGuards class >> mismatchOf: key [
	"nil when the guarded method of key has an accepted source, else a description"

	| m accepted |
	m := self methodAt: key.
	m ifNil: [ ^ 'guard: ' , (self nameOfKey: key) , ' is missing' ].
	accepted := self acceptedHashes at: (self nameOfKey: key) ifAbsent: [ #(  ) ].
	(accepted includes: (self hashOf: m)) ifFalse: [
		^ 'guard: ' , (self nameOfKey: key) , ' has a source CairoPlugin was not verified with' ].
	^ nil
]

{ #category : 'checking' }
CairoPluginGuards class >> mismatchesOf: group [

	| accepted |
	accepted := self acceptedHashes.
	^ ((self entriesOf: group) collect: [ :key |
		   | m |
		   m := self methodAt: key.
		   m
			   ifNil: [ 'guard: ' , (self nameOfKey: key) , ' is missing' ]
			   ifNotNil: [
				   ((accepted at: (self nameOfKey: key) ifAbsent: [ #(  ) ]) includes:
					    (self hashOf: m))
					   ifTrue: [ nil ]
					   ifFalse: [
						   'guard: ' , (self nameOfKey: key)
						   , ' has a source CairoPlugin was not verified with' ] ] ])
		  reject: [ :each | each isNil ]
]

{ #category : 'entries' }
CairoPluginGuards class >> nameOfKey: key [

	^ (key at: 1) , ((key at: 2)
		   ifTrue: [ ' class>>' ]
		   ifFalse: [ '>>' ]) , (key at: 3)
]

{ #category : 'hashes' }
CairoPluginGuards class >> normalize: aString [

	^ ((aString copyReplaceAll: String crlf with: String cr)
		   copyReplaceAll: String lf
		   with: String cr) trimBoth
]

{ #category : 'entries' }
CairoPluginGuards class >> overrideClassNames [
	"The classes whose subclasses must not override a replicated selector of #shape and #text"

	^ #( #AthensCairoCanvas #AthensCairoSurface #AthensCairoPathBuilder #CairoFreetypeFontRenderer
	     #CairoScaledFont #Color #AthensCairoStrokePaint #AthensCairoPath #Rectangle )
]

{ #category : 'entries' }
CairoPluginGuards class >> shapeEntries [
	"The methods the shape primitives replicate (the stock draw of a Rectangle or an AthensCairoPath with a Color or an AthensCairoStrokePaint of a Color); AthensCanvas>>surface is looked up from AthensCairoCanvas"

	^ #(
	#( #AthensCairoCanvas false #draw )
	#( #AthensCairoCanvas false #setPathMatrix )
	#( #AthensCairoCanvas false #newPath )
	#( #AthensCairoCanvas false #fill )
	#( #AthensCairoCanvas false #stroke )
	#( #AthensCairoCanvas false #loadPath: )
	#( #AthensCairoCanvas false #resetDash )
	#( #AthensCairoCanvas false #setSourceR:g:b:a: )
	#( #AthensCairoCanvas false #primSetSourceR:g:b:a: )
	#( #AthensCairoCanvas false #primResetDashes: )
	#( #AthensCairoCanvas false #rectangleX:y:width:height: )
	#( #AthensCairoCanvas false #primRectangleX:y:width:height: )
	#( #AthensCairoCanvas false #primSetLineWidth: )
	#( #AthensCairoCanvas false #primSetLineJoin: )
	#( #AthensCairoCanvas false #primSetLineCap: )
	#( #AthensCairoCanvas false #primSetDashesLengths:count:offset: )
	#( #AthensCairoCanvas false #surface )
	#( #AthensCairoSurface false #fillRectangle:withSolidColor: )
	#( #AthensCairoSurface false #fillPath:withSolidColor: )
	#( #AthensCairoSurface false #loadSolidColor: )
	#( #AthensCairoSurface false #drawDuring: )
	#( #AthensCairoStrokePaint false #prepareForDrawingOn: )
	#( #AthensCairoStrokePaint false #athensFillRectangle:on: )
	#( #AthensCairoStrokePaint false #athensFillPath:on: )
	#( #AthensCairoStrokePaint false #setDashesOn: )
	#( #Color false #athensFillRectangle:on: )
	#( #Color false #athensFillPath:on: )
	#( #Color false #loadOnCairoCanvas: )
	#( #Color false #red )
	#( #Color false #green )
	#( #Color false #blue )
	#( #Color false #alpha )
	#( #Color false #privateRed )
	#( #Color false #privateGreen )
	#( #Color false #privateBlue )
	#( #Rectangle false #paintFillsUsing:on: )
	#( #Rectangle false #left )
	#( #Rectangle false #top )
	#( #Rectangle false #width )
	#( #Rectangle false #height )
	#( #AthensCairoPath false #paintFillsUsing:on: ) )
]

{ #category : 'checking' }
CairoPluginGuards class >> subclassOverridesOf: group [
	"For #shape and #text: the methods of subclasses of #overrideClassNames that override a replicated selector (the primitive would bypass them), as descriptions"

	| found |
	found := OrderedCollection new.
	group = #basic ifTrue: [ ^ #(  ) ].
	(self entriesOf: group) do: [ :key |
		((key at: 2) not and: [ self overrideClassNames includes: (key at: 1) ])
			ifTrue: [
				(Smalltalk globals at: (key at: 1) ifAbsent: [ nil ]) ifNotNil: [ :cls |
					cls allSubclasses do: [ :sub |
						(sub includesSelector: (key at: 3)) ifTrue: [
							found add: 'subclass override: ' , sub name , '>>' , (key at: 3) ] ] ] ] ].
	^ found asArray
]

{ #category : 'entries' }
CairoPluginGuards class >> textEntries [
	"The methods the text primitive replicates (the stock drawString: of a font without kerning painted with a Color), including the UTF-8 conversion (CairoUTF8Converter through ZnUTF8Encoder) that the plugin does with simdutf; AthensCanvas>>paint is looked up from AthensCairoCanvas"

	^ #(
	#( #CairoFreetypeFontRenderer false #renderCharacters:from:to: )
	#( #CairoFreetypeFontRenderer false #glyphsOf:from:to: )
	#( #CairoFreetypeFontRenderer false #renderGlyphs: )
	#( #CairoFreetypeFontRenderer false #convertString:len:ofFont:toGlyphs:numGlyphs:x:y: )
	#( #CairoFreetypeFontRenderer false #freeGlyphs: )
	#( #CairoFreetypeFontRenderer false #advance )
	#( #AthensCairoCanvas false #setScaledFont: )
	#( #AthensCairoCanvas false #setFontSize: )
	#( #AthensCairoCanvas false #primSetFontSize: )
	#( #AthensCairoCanvas false #getScaledFont )
	#( #AthensCairoCanvas false #showGlyphs:size: )
	#( #AthensCairoCanvas false #setPathMatrix )
	#( #AthensCairoCanvas false #paint )
	#( #CairoScaledFont false #lock )
	#( #CairoScaledFont false #unlock )
	#( #CairoScaledFont false #getExtentsOfGlyphs:ofLength:into: )
	#( #Color false #loadOnCairoCanvas: )
	#( #Color false #red )
	#( #Color false #green )
	#( #Color false #blue )
	#( #Color false #alpha )
	#( #Color false #privateRed )
	#( #Color false #privateGreen )
	#( #Color false #privateBlue )
	#( #CairoUTF8Converter false #initialize )
	#( #CairoUTF8Converter false #convert:from:to: )
	#( #CairoUTF8Converter false #checkBufferSpace: )
	#( #CairoUTF8Converter false #buffer )
	#( #ZnUTF8Encoder false #next:putAll:startingAt:toStream: )
	#( #ZnUTF8Encoder false #next:putAllByteString:startingAt:toStream: )
	#( #ZnUTF8Encoder false #next:putAllASCII:startingAt:toStream: )
	#( #ZnUTF8Encoder false #findFirstNonASCIIIn:startingAt: )
	#( #ZnUTF8Encoder false #nextPut:toStream: )
	#( #ZnUTF8Encoder false #nextPutCodePoint:toStream: )
	#( #ZnUTF8Encoder false #isSurrogateCodePoint: )
	#( #ZnUTF8Encoder false #maximumUTFCode )
	#( #ZnCharacterEncoder false #next:putAll:startingAt:toStream: )
	#( #FreeTypeFont false #face )
	#( #FreeTypeFace false #hasKerning )
	#( #CairoTextExtents false #width )
	#( #CairoTextExtents false #height )
	#( #AthensCairoSurface false #getFreetypeFontRendererFor: )
